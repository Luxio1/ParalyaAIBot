# Copier ce fichier en « .env » puis adapter les valeurs.

# development | production | test
NODE_ENV=development

# Adresse et port d'écoute du serveur (API + dashboard en production).
HOST=127.0.0.1
PORT=3000

# Dossier des données persistantes (base SQLite). En Docker : /data
DATA_DIR=./data

# Clé maîtresse servant à chiffrer les secrets en base (token Discord, clés IA).
# OBLIGATOIRE, 32 caractères minimum. À générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ Si elle change ou est perdue, les secrets enregistrés deviennent illisibles.
APP_SECRET=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optionnel : clé Gemini de repli, utilisée si aucune clé n'est saisie dans le dashboard.
GEMINI_API_KEY=
